<style>
:root{
  --ink:#14191c; --ink-2:#2b3439; --ink-soft:#4d585e; --ink-mute:#6f7b81;
  --stone:#eeedea; --stone-2:#e4e2dc; --stone-3:#d6d3cb; --stone-4:#c3bfb6;
  --basalt:#38444a; --basalt-2:#2a3237; --basalt-3:#1d2427;
  --wet:#0b5f66; --wet-2:#0e7b84; --wet-3:#17a2ac; --wet-wash:#e3edec;
  --warn:#8a5a2b; --warn-wash:#f2e7da;
  --seam:rgba(20,25,28,.13); --seam-2:rgba(20,25,28,.07);
  --paper:#f7f6f4;
  --shadow:0 1px 2px rgba(20,25,28,.05),0 8px 24px -12px rgba(20,25,28,.18);
  --shadow-lg:0 2px 4px rgba(20,25,28,.06),0 24px 48px -20px rgba(20,25,28,.28);
  --r:5px; --r-lg:9px;
  --maxw:1180px; --gut:clamp(18px,4vw,44px);
  --f-disp:"Archivo","Arial Narrow",Helvetica,sans-serif;
  --f-body:"Source Serif 4",Georgia,"Times New Roman",serif;
  --f-mono:"JetBrains Mono",ui-monospace,"SFMono-Regular",Consolas,monospace;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}
 *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}}
body{margin:0;background:var(--stone);color:var(--ink);
  font-family:var(--f-body);font-size:17.5px;line-height:1.66;font-optical-sizing:auto;
  -webkit-font-smoothing:antialiased;overflow-x:hidden}
img,svg{max-width:100%}
a{color:var(--wet);text-underline-offset:3px;text-decoration-thickness:1px}
a:hover{color:var(--wet-2)}
:focus-visible{outline:2.5px solid var(--wet-3);outline-offset:2px;border-radius:2px}
h1,h2,h3,h4{font-family:var(--f-disp);font-weight:700;line-height:1.08;
  letter-spacing:-.012em;color:var(--ink);margin:0 0 .5em;text-wrap:balance}
h1{font-size:clamp(2.15rem,5.4vw,3.75rem);font-stretch:112%;letter-spacing:-.02em}
h2{font-size:clamp(1.6rem,3.5vw,2.5rem);font-stretch:108%;letter-spacing:-.016em}
h3{font-size:clamp(1.13rem,2vw,1.42rem);font-stretch:104%}
h4{font-size:1.02rem;font-stretch:100%;letter-spacing:.005em}
p{margin:0 0 1.05em}
p:last-child{margin-bottom:0}
strong{font-weight:600;color:var(--ink)}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--gut)}
.narrow{max-width:800px}
.eyebrow{font-family:var(--f-mono);font-size:.68rem;letter-spacing:.19em;
  text-transform:uppercase;color:var(--wet);font-weight:600;margin:0 0 .85em;display:block}
.eyebrow.on-dark{color:var(--wet-3)}
.lede{font-size:clamp(1.06rem,2.1vw,1.24rem);line-height:1.6;color:var(--ink-2)}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
  clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:0;z-index:400;background:var(--wet);color:#fff;
  padding:12px 18px;font-family:var(--f-disp);font-weight:600}
.skip:focus{left:8px;top:8px}

/* ---- seam divider: the structural motif ---- */
.seam{height:0;border-top:1px solid var(--seam);position:relative}
.seam::after{content:"";position:absolute;left:0;right:0;top:0;height:2px;
  background:linear-gradient(180deg,rgba(255,255,255,.85),rgba(255,255,255,0))}

/* ---- header ---- */
.topbar{background:var(--basalt-3);color:#cdd6d9;font-family:var(--f-mono);
  font-size:.71rem;letter-spacing:.05em}
.topbar .wrap{display:flex;gap:14px;align-items:center;justify-content:space-between;
  min-height:34px;flex-wrap:wrap;padding-top:5px;padding-bottom:5px}
.topbar a{color:#eaf1f2;text-decoration:none;font-weight:600}
.topbar a:hover{color:var(--wet-3)}
.topbar .tb-note{color:#93a2a7}
header.site{position:sticky;top:0;z-index:120;background:rgba(238,237,234,.94);
  backdrop-filter:saturate(1.6) blur(9px);border-bottom:1px solid var(--seam)}
.hd{display:flex;align-items:center;justify-content:space-between;gap:16px;
  min-height:70px;padding-top:9px;padding-bottom:9px}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--ink);flex:0 0 auto}
.brand svg{display:block;width:38px;height:38px;flex:0 0 auto}
.brand b{font-family:var(--f-disp);font-weight:800;font-stretch:118%;font-size:1.03rem;
  letter-spacing:-.02em;line-height:1.02;display:block;text-transform:uppercase}
.brand span{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.15em;
  color:var(--ink-mute);text-transform:uppercase;display:block;margin-top:2px}
nav.main{display:flex;align-items:center;gap:3px}
nav.main a{font-family:var(--f-disp);font-size:.855rem;font-weight:600;letter-spacing:.005em;
  color:var(--ink-2);text-decoration:none;padding:8px 10px;border-radius:var(--r);white-space:nowrap}
nav.main a:hover{background:var(--stone-2);color:var(--ink)}
nav.main a[aria-current="page"]{color:var(--wet);background:var(--wet-wash)}
.hd-cta{display:flex;align-items:center;gap:9px;flex:0 0 auto}
.burger{display:none;width:44px;height:44px;border:1px solid var(--stone-4);background:var(--paper);
  border-radius:var(--r);cursor:pointer;padding:0;align-items:center;justify-content:center}
.burger span{display:block;width:19px;height:2px;background:var(--ink);position:relative}
.burger span::before,.burger span::after{content:"";position:absolute;left:0;width:19px;height:2px;background:var(--ink)}
.burger span::before{top:-6px}.burger span::after{top:6px}

/* ---- buttons ---- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  font-family:var(--f-disp);font-weight:700;font-size:.93rem;letter-spacing:.005em;
  padding:13px 22px;border-radius:var(--r);text-decoration:none;cursor:pointer;
  border:1px solid transparent;transition:transform .12s ease,background .16s ease,box-shadow .16s ease;
  line-height:1.15;text-align:center}
.btn:hover{transform:translateY(-1px)}
.btn:active{transform:translateY(0)}
.btn-p{background:var(--wet);color:#fff;box-shadow:var(--shadow)}
.btn-p:hover{background:var(--wet-2);color:#fff}
.btn-o{background:transparent;color:var(--ink);border-color:var(--stone-4)}
.btn-o:hover{border-color:var(--ink-soft);background:var(--paper);color:var(--ink)}
.btn-l{background:var(--paper);color:var(--wet);border-color:rgba(255,255,255,.3)}
.btn-l:hover{background:#fff;color:var(--wet)}
.btn-sm{padding:9px 15px;font-size:.83rem}
.btn-lg{padding:16px 30px;font-size:1.01rem}

/* ---- sections ---- */
section{padding:clamp(52px,7.5vw,92px) 0}
section.tight{padding:clamp(38px,5vw,60px) 0}
.band-dark{background:var(--basalt);color:#dfe6e8}
.band-dark h2,.band-dark h3,.band-dark h4{color:#fff}
.band-dark p{color:#c8d2d5}
.band-dark a:not(.btn){color:var(--wet-3)}
.band-paper{background:var(--paper)}
.band-wash{background:var(--wet-wash)}
.sec-head{max-width:760px;margin-bottom:clamp(28px,4vw,46px)}
.sec-head p{color:var(--ink-soft);font-size:1.06rem}
.band-dark .sec-head p{color:#bcc7cb}

/* ---- cards / grids ---- */
.grid{display:grid;gap:clamp(14px,2vw,22px)}
.g2{grid-template-columns:repeat(2,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
.card{background:var(--paper);border:1px solid var(--stone-3);border-radius:var(--r-lg);
  padding:clamp(18px,2.4vw,26px);position:relative}
.card h3{margin-bottom:.4em}
.card p{font-size:.98rem;color:var(--ink-soft)}
.card p:last-child{margin-bottom:0}
.band-dark .card{background:var(--basalt-2);border-color:rgba(255,255,255,.11)}
.band-dark .card p{color:#bcc7cb}
.card-tag{font-family:var(--f-mono);font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;
  color:var(--wet);font-weight:600;display:block;margin-bottom:.7em}
.band-dark .card-tag{color:var(--wet-3)}

/* ---- spec table ---- */
.tbl-wrap{overflow-x:auto;border:1px solid var(--stone-3);border-radius:var(--r-lg);background:var(--paper);
  -webkit-overflow-scrolling:touch}
table{border-collapse:collapse;width:100%;min-width:600px;font-size:.93rem}
caption{text-align:left;font-family:var(--f-mono);font-size:.68rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--ink-mute);padding:14px 16px 0}
th,td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--stone-3);vertical-align:top}
thead th{font-family:var(--f-disp);font-size:.74rem;letter-spacing:.11em;text-transform:uppercase;
  font-weight:700;color:var(--ink);background:var(--stone-2);border-bottom:1.5px solid var(--stone-4);
  position:sticky;top:0}
tbody tr:last-child td{border-bottom:none}
tbody tr:nth-child(even){background:rgba(20,25,28,.018)}
td.num,th.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
.tbl-note{font-size:.82rem;color:var(--ink-mute);margin-top:10px;font-family:var(--f-body)}

/* ---- fact sheet ---- */
.facts{background:var(--paper);border:1px solid var(--stone-3);border-radius:var(--r-lg);overflow:hidden}
.facts h2{font-size:1.05rem;padding:16px 20px;margin:0;background:var(--stone-2);
  border-bottom:1px solid var(--stone-3);letter-spacing:.06em;text-transform:uppercase;font-size:.8rem}
.facts dl{margin:0;display:grid;grid-template-columns:minmax(140px,190px) 1fr}
.facts dt{font-family:var(--f-mono);font-size:.73rem;letter-spacing:.07em;text-transform:uppercase;
  color:var(--ink-mute);padding:11px 20px;border-bottom:1px solid var(--stone-3);font-weight:600}
.facts dd{margin:0;padding:11px 20px;border-bottom:1px solid var(--stone-3);font-size:.94rem}
.facts dt:last-of-type,.facts dl>dd:last-child{border-bottom:none}

/* ---- FAQ ---- */
.faq{border-top:1px solid var(--seam)}
.faq details{border-bottom:1px solid var(--seam)}
.faq summary{cursor:pointer;list-style:none;padding:19px 44px 19px 0;position:relative;
  font-family:var(--f-disp);font-weight:600;font-size:1.03rem;color:var(--ink);line-height:1.32}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"";position:absolute;right:8px;top:50%;width:11px;height:11px;
  border-right:2px solid var(--wet);border-bottom:2px solid var(--wet);
  transform:translateY(-70%) rotate(45deg);transition:transform .18s ease}
.faq details[open] summary::after{transform:translateY(-30%) rotate(-135deg)}
.faq summary:hover{color:var(--wet)}
.faq .ans{padding:0 4px 22px 0;color:var(--ink-soft);font-size:1rem;max-width:80ch}
.faq .ans p:last-child{margin-bottom:0}

/* ---- callout ---- */
.callout{border-left:3px solid var(--wet);background:var(--wet-wash);padding:18px 22px;
  border-radius:0 var(--r) var(--r) 0;margin:26px 0}
.callout p{font-size:.98rem;color:var(--ink-2)}
.callout.warn{border-left-color:var(--warn);background:var(--warn-wash)}

/* ---- lead form ---- */
.lead{background:var(--basalt-2);border-radius:var(--r-lg);padding:clamp(22px,3.2vw,38px);
  border:1px solid rgba(255,255,255,.1)}
.lead h2{color:#fff;font-size:clamp(1.4rem,2.7vw,1.95rem)}
.lead .lede{color:#c2ccd0}
.f-grid{display:grid;gap:13px;grid-template-columns:repeat(2,1fr);margin-top:22px}
.f-full{grid-column:1/-1}
.lead label{display:block;font-family:var(--f-mono);font-size:.66rem;letter-spacing:.14em;
  text-transform:uppercase;color:#a8b5ba;margin-bottom:6px;font-weight:600}
.lead input,.lead select,.lead textarea{width:100%;padding:12px 13px;border-radius:var(--r);
  border:1px solid rgba(255,255,255,.19);background:rgba(255,255,255,.06);color:#fff;
  font-family:var(--f-body);font-size:1rem}
.lead textarea{min-height:88px;resize:vertical}
.lead input::placeholder,.lead textarea::placeholder{color:#7e8b90}
.lead input:focus,.lead select:focus,.lead textarea:focus{border-color:var(--wet-3);
  background:rgba(255,255,255,.1);outline:none;box-shadow:0 0 0 3px rgba(23,162,172,.22)}
.lead select option{background:var(--basalt-2);color:#fff}
.f-honey{position:absolute!important;left:-9999px!important;opacity:0;height:0;width:0;
  pointer-events:none;overflow:hidden}
.f-msg{margin-top:14px;font-family:var(--f-mono);font-size:.8rem;padding:11px 13px;border-radius:var(--r);display:none}
.f-msg.ok{display:block;background:rgba(23,162,172,.16);color:#9fe3e8;border:1px solid rgba(23,162,172,.4)}
.f-msg.warnmsg{display:block;background:rgba(200,150,60,.14);color:#e8cf9a;border:1px solid rgba(200,150,60,.4)}
.f-msg.err{display:block;background:rgba(200,80,60,.14);color:#f0b2a4;border:1px solid rgba(200,80,60,.4)}
.f-fine{font-size:.78rem;color:#8d999e;margin-top:12px;font-family:var(--f-body)}
.f-fine a{color:var(--wet-3)}

/* ---- footer ---- */
footer.site{background:var(--basalt-3);color:#a9b6bb;padding:clamp(44px,6vw,68px) 0 26px;
  font-size:.92rem}
footer.site h4{color:#fff;font-size:.73rem;letter-spacing:.15em;text-transform:uppercase;
  font-family:var(--f-mono);font-weight:600;margin-bottom:13px}
footer.site a{color:#cdd8db;text-decoration:none}
footer.site a:hover{color:var(--wet-3);text-decoration:underline}
.f-cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:clamp(20px,3vw,40px)}
.f-cols ul{list-style:none;margin:0;padding:0}
.f-cols li{margin-bottom:8px;line-height:1.4}
.f-brand p{font-size:.9rem;color:#93a2a7;max-width:34ch}
.f-brand .brand b{color:#fff}
.f-brand .brand span{color:#7e8d92}
.f-bot{margin-top:34px;padding-top:20px;border-top:1px solid rgba(255,255,255,.11);
  display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
  font-family:var(--f-mono);font-size:.71rem;letter-spacing:.04em;color:#7e8d92}
.f-bot a{color:#a9b6bb}
.f-call{display:inline-flex;align-items:baseline;gap:9px;margin:14px 0 4px}
.f-call strong{font-family:var(--f-disp);font-size:1.32rem;font-stretch:110%;color:#fff;font-weight:700}

/* ---- sticky mobile call bar ---- */
.callbar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:130;
  background:var(--wet);border-top:1px solid rgba(255,255,255,.2);padding:9px 12px calc(9px + env(safe-area-inset-bottom))}
.callbar a{flex:1;text-decoration:none}
.callbar .btn{width:100%}

/* ---- responsive ---- */
@media(max-width:1040px){
  nav.main a{padding:8px 7px;font-size:.8rem}
  .brand span{display:none}
}
@media(max-width:768px){
  body{font-size:17px}
  .burger{display:flex}
  nav.main{position:fixed;left:0;right:0;top:var(--hdh,104px);background:var(--paper);
    flex-direction:column;align-items:stretch;gap:0;padding:10px 0 18px;
    border-bottom:1px solid var(--stone-3);box-shadow:var(--shadow-lg);
    max-height:calc(100vh - var(--hdh,104px));overflow-y:auto;display:none}
  nav.main.open{display:flex}
  nav.main a{padding:13px var(--gut);border-radius:0;font-size:1rem;border-bottom:1px solid var(--stone-2)}
  .hd-cta .btn-quote{display:none}
  .g2,.g3,.g4{grid-template-columns:1fr}
  .f-grid{grid-template-columns:1fr}
  .f-cols{grid-template-columns:1fr 1fr}
  .facts dl{grid-template-columns:1fr}
  .facts dt{padding-bottom:2px;border-bottom:none}
  .callbar{display:flex;gap:8px}
  body{padding-bottom:66px}
  .topbar .tb-note{display:none}
}
@media(max-width:520px){
  .f-cols{grid-template-columns:1fr}
  .g2.keep2,.g3.keep2{grid-template-columns:1fr 1fr}
}

.phero{background:linear-gradient(180deg,var(--stone) 0%,var(--stone-2) 100%);
  padding:clamp(30px,4.5vw,52px) 0 clamp(30px,4.5vw,50px);border-bottom:1px solid var(--seam)}
.crumbs{font-family:var(--f-mono);font-size:.7rem;letter-spacing:.06em;color:var(--ink-mute);margin-bottom:16px}
.crumbs a{color:var(--ink-soft);text-decoration:none}
.crumbs a:hover{color:var(--wet)}
.crumbs span{margin:0 7px;opacity:.5}
.phero h1{max-width:20ch}
.phero .lede{max-width:62ch}
.phero-cta{display:flex;gap:11px;flex-wrap:wrap;margin-top:24px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,54px);align-items:center}
.toc{background:var(--paper);border:1px solid var(--stone-3);border-radius:var(--r-lg);padding:18px 22px;margin:0 0 34px}
.toc h2{font-size:.74rem;letter-spacing:.15em;text-transform:uppercase;font-family:var(--f-mono);
  color:var(--ink-mute);margin-bottom:11px}
.toc ol{margin:0;padding-left:18px;columns:2;column-gap:30px}
.toc li{margin-bottom:6px;font-size:.94rem;break-inside:avoid}
.prose h2{margin-top:1.5em}
.prose h3{margin-top:1.4em;font-size:1.14rem}
.prose ul,.prose ol{padding-left:22px;margin:0 0 1.1em}
.prose li{margin-bottom:.5em}
.prose>*:first-child{margin-top:0}
@media(max-width:860px){.two{grid-template-columns:1fr}.toc ol{columns:1}}

.tool{background:var(--basalt-2);border-radius:var(--r-lg);padding:clamp(20px,3vw,32px);
  color:#dfe6e8;border:1px solid rgba(255,255,255,.11);margin:32px 0}
.tool h3{color:#fff;margin-bottom:.3em}
.tool>p.intro{color:#c2ccd0;font-size:.96rem;margin-bottom:4px}
.t-in{display:grid;gap:13px;margin:20px 0 6px}
.t-in.c4{grid-template-columns:repeat(4,1fr)}
.t-in.c3{grid-template-columns:repeat(3,1fr)}
.t-in.c2{grid-template-columns:repeat(2,1fr)}
.tool label{display:block;font-family:var(--f-mono);font-size:.6rem;letter-spacing:.13em;
  text-transform:uppercase;color:#a8b5ba;margin-bottom:6px;font-weight:600}
.tool select,.tool input[type=number],.tool input[type=text]{width:100%;padding:10px 11px;border-radius:var(--r);
  border:1px solid rgba(255,255,255,.19);background:rgba(255,255,255,.06);color:#fff;
  font-family:var(--f-mono);font-size:.94rem}
.tool select option{background:var(--basalt-2)}
.tool select:focus,.tool input:focus{border-color:var(--wet-3);outline:none;box-shadow:0 0 0 3px rgba(23,162,172,.22)}
.tool input[type=range]{width:100%;accent-color:var(--wet-3);padding:0}
.paths{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.13);
  border-radius:var(--r);overflow:hidden;margin-top:16px}
.paths>div{background:var(--basalt-3);padding:17px 16px}
