<script>
(function(){
  var b=document.getElementById('burger'),n=document.getElementById('nav');
  function measureHeader(){
    var tb=document.querySelector('.topbar'),hd=document.querySelector('header.site');
    var h=(hd?hd.getBoundingClientRect().height:70);
    var t=(tb?tb.getBoundingClientRect().height:0);
    var top=hd?hd.getBoundingClientRect().bottom:h+t;
    document.documentElement.style.setProperty('--hdh',Math.round(top)+'px');
  }
  measureHeader();
  window.addEventListener('resize',measureHeader,{passive:true});
  window.addEventListener('scroll',function(){if(n&&n.classList.contains('open'))measureHeader();},{passive:true});
  if(b&&n){
    b.addEventListener('click',function(){
      measureHeader();
      var open=n.classList.toggle('open');
      b.setAttribute('aria-expanded',open?'true':'false');
      b.setAttribute('aria-label',open?'Close menu':'Open menu');
    });
    n.addEventListener('click',function(e){if(e.target.tagName==='A'){n.classList.remove('open');b.setAttribute('aria-expanded','false');}});
  }
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&n&&n.classList.contains('open')){n.classList.remove('open');b.setAttribute('aria-expanded','false');b.focus();}
  });
})();
/* ---- form transport: two-stage FormSubmit, honest states ---- */
(function(){
  function buildAction(){
    var u=['sales','agingsafelybaths.com'];
    return 'https://formsubmit.co/'+u[0]+'@'+u[1];
  }
  function ajaxAction(){
    var u=['sales','agingsafelybaths.com'];
    return 'https://formsubmit.co/ajax/'+u[0]+'@'+u[1];
  }
  function setMsg(el,cls,txt){el.className='f-msg '+cls;el.textContent=txt;}
  document.querySelectorAll('form[id^="f-"]').forEach(function(form){
    var msg=document.getElementById('m-'+form.id.slice(2));
    form.addEventListener('submit',function(e){
      e.preventDefault();
      if(!msg)return;
      var honey=form.querySelector('[name="_honey"]');
      if(honey&&honey.value){setMsg(msg,'ok','Thanks \u2014 we\u2019ll be in touch.');return;}
      var req=form.querySelectorAll('[required]');
      for(var i=0;i<req.length;i++){
        if(!req[i].value.trim()){
          setMsg(msg,'err','Add your '+(req[i].previousElementSibling?req[i].previousElementSibling.textContent.toLowerCase():'details')+' so we can reply.');
          req[i].focus();return;
        }
      }
      var em=form.querySelector('[type="email"]');
      if(em&&!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(em.value)){
        setMsg(msg,'err','That email address doesn\u2019t look right. Check it and send again.');em.focus();return;
      }
      var btn=form.querySelector('button[type="submit"]');
      if(btn){btn.disabled=true;btn.textContent='Sending\u2026';}
      setMsg(msg,'warnmsg','Sending\u2026');
      var data=new FormData(form);
      var obj={};data.forEach(function(v,k){obj[k]=v;});
      fetch(ajaxAction(),{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(obj)})
      .then(function(r){return r.ok?r.json():Promise.reject(r.status);})
      .then(function(){
        setMsg(msg,'ok','Sent. We\u2019ll reply within one business day \u2014 check your spam folder just in case.');
        form.reset();
        if(btn){btn.textContent='Sent';}
      })
      .catch(function(){
        /* stage two: hidden iframe fallback */
        try{
          var fr=document.createElement('iframe');fr.name='fs-'+Date.now();fr.style.display='none';
          document.body.appendChild(fr);
          var f2=document.createElement('form');
          f2.method='POST';f2.action=buildAction();f2.target=fr.name;f2.style.display='none';
          data.forEach(function(v,k){var i=document.createElement('input');i.type='hidden';i.name=k;i.value=v;f2.appendChild(i);});
          document.body.appendChild(f2);f2.submit();
          setMsg(msg,'warnmsg','Submitted, but we couldn\u2019t confirm it landed. If you don\u2019t hear back today, call '+'1-888-779-2284'+' or email sales@agingsafelybaths.com.');
          if(btn){btn.disabled=false;btn.textContent='Send my measurements';}
        }catch(err){
          setMsg(msg,'err','That didn\u2019t send. Call 1-888-779-2284 or email sales@agingsafelybaths.com and we\u2019ll pick it up from there.');
          if(btn){btn.disabled=false;btn.textContent='Send my measurements';}
        }
      });
    });
  });
})();
</script>
<script>
(function(){
  var ids=['e-w','e-d','e-h','e-layout','e-mat','e-region','e-demo'];
  function usd(n){return '$'+(Math.round(n/50)*50).toLocaleString('en-US');}
  function run(){
    var w=+document.getElementById('e-w').value||60,
        d=+document.getElementById('e-d').value||32,
        h=+document.getElementById('e-h').value||80,
        L=document.getElementById('e-layout').value,
        m=+document.getElementById('e-mat').value,
        r=+document.getElementById('e-region').value,
        demo=+document.getElementById('e-demo').value||0;
    var sf = (L==='2') ? (w*h + d*h)/144 : (w*h + 2*d*h)/144;
    var kitLo = sf*m*0.86 + 150, kitHi = sf*m*1.18 + 280;
    var fitLo = (sf*10 + 260)*r, fitHi = (sf*19 + 620)*r;
    if(demo){ fitLo += 420*r; fitHi += 1050*r; }
    // full-service: kit at retail markup + managed labour + overhead/acquisition
    var fsLo = (kitHi*1.9 + fitHi*2.3) , fsHi = (kitHi*2.7 + fitHi*3.6);
    if(fsLo<9000) fsLo=9000;
    document.getElementById('e-area').textContent=Math.round(sf)+' sq ft';
    document.getElementById('e-diy').innerHTML=usd(kitLo)+'&ndash;'+usd(kitHi)+
      '<small>You buy the kit and fit it. Two days of your weekend and the risk is yours.</small>';
    document.getElementById('e-ind').innerHTML=usd(kitLo+fitLo)+'&ndash;'+usd(kitHi+fitHi)+
      '<small>You buy the kit, a local fitter installs it. Usually the best value if you can manage the coordination.</small>';
    document.getElementById('e-full').innerHTML=usd(fsLo)+'&ndash;'+usd(fsHi)+
      '<small>One contract, one warranty, one company responsible. You pay for that and for the sales process that reached you.</small>';
    var mid=(kitHi+fitHi+kitLo+fitLo)/2, fsMid=(fsLo+fsHi)/2, x=fsMid/mid;
    document.getElementById('e-verdict').innerHTML=
      '<strong>Path C runs about '+x.toFixed(1)+'&times; Path B</strong> at these inputs. Some of that gap is real \u2014 a single warranty, '+
      'a managed crew, and someone who has to come back if it leaks. The rest is overhead and customer acquisition. '+
      'The way to find out which you are being sold is to ask which manufacturer and model panel is going in, then price that panel yourself.';
  }
  ids.forEach(function(i){var e=document.getElementById(i);if(e){e.addEventListener('input',run);e.addEventListener('change',run);}});
  run();
})();
</script><script>
(function(){
  function run(){
    var tot=+document.getElementById('q-total').value||0,
        w=+document.getElementById('q-w').value||60,
        d=+document.getElementById('q-d').value||32,
        h=+document.getElementById('q-h').value||80,
        inc=document.getElementById('q-inc').value,
        mat=+document.getElementById('q-mat').value;
    var sf=(w*h + 2*d*h)/144;
    // strip out non-wall scope so we compare like for like
    var adj=tot;
    if(inc==='walls_pan') adj = tot - 900;
    if(inc==='full') adj = tot - 2400;
    if(adj<100) adj=100;
    var psf=adj/sf;
    document.getElementById('q-area').textContent=Math.round(sf)+' sq ft';
    document.getElementById('q-psf').textContent='$'+psf.toFixed(0);
    // benchmark bands for walls, supplied and installed, per sq ft
    var lo=28, fair=62, prem=105, high=175;
    var pos;
    if(psf<lo) pos=(psf/lo)*25;
    else if(psf<fair) pos=25+((psf-lo)/(fair-lo))*25;
    else if(psf<prem) pos=50+((psf-fair)/(prem-fair))*25;
    else pos=75+Math.min(25,((psf-prem)/(high-prem))*25);
    document.getElementById('q-mark').style.left=Math.max(1,Math.min(99,pos))+'%';
    var v=document.getElementById('q-verdict');
    if(psf<lo){
      v.className='verdict warn';
      v.innerHTML='<strong>Low enough to ask why.</strong> At about $'+psf.toFixed(0)+' per square foot installed, either this is a thin panel, '+
        'the labour is not really included, or the substrate work has been assumed away. Cheap is not automatically bad \u2014 but get the panel model, '+
        'the thickness, and a written scope before you sign anything.';
    } else if(psf<fair){
      v.className='verdict good';
      v.innerHTML='<strong>This sits in the fair band.</strong> About $'+psf.toFixed(0)+' per square foot installed is consistent with a real panel '+
        'and real labour without a large acquisition cost loaded on top. Check the warranty terms and whether the number includes removing what is there now.';
    } else if(psf<prem){
      v.className='verdict ok';
      v.innerHTML='<strong>Premium, but defensible.</strong> About $'+psf.toFixed(0)+' per square foot installed is what a good full-service job with a '+
        'long warranty and a managed crew costs. Worth confirming what the warranty actually covers, whether it includes labour, and whether it transfers if you sell.';
    } else {
      v.className='verdict bad';
      v.innerHTML='<strong>High enough that you should push back.</strong> At roughly $'+psf.toFixed(0)+' per square foot installed you are well above what '+
        'the panels and the labour cost. That gap may buy a genuinely excellent warranty \u2014 or it may be marketing and commission. '+
        'Ask for the manufacturer and model, price that panel independently, and get a second quote from a local installer before deciding.';
    }
    if(mat===0){
      v.innerHTML+=' <br><br><strong>They would not name the panel.</strong> That is the single biggest red flag in this category. '+
        'A company confident in its product will tell you exactly what it is installing.';
    }
  }
  ['q-total','q-w','q-d','q-h','q-inc','q-mat'].forEach(function(i){
    var e=document.getElementById(i);if(e){e.addEventListener('input',run);e.addEventListener('change',run);}});
  run();
})();
</script><script>
(function(){
  function usd(n){return '$'+Math.round(n).toLocaleString('en-US');}
  function run(){
    var P=+document.getElementById('f-amt').value||0,
        apr=+document.getElementById('f-apr').value||0,
        n=+document.getElementById('f-term').value||60,
        promo=+document.getElementById('f-promo').value||0;
    var i=apr/100/12, m = i===0 ? P/n : P*i/(1-Math.pow(1+i,-n));
    var tot=m*n, interest=tot-P;
    document.getElementById('f-mo').textContent=usd(m);
    document.getElementById('f-int').textContent=usd(interest);
    document.getElementById('f-tot').textContent=usd(tot);
    document.getElementById('f-mult').textContent=(tot/P).toFixed(2)+'\u00d7';
    var v=document.getElementById('f-verdict');
    if(promo>0){
      var accrued=P*i*promo;
      v.className='verdict warn';
      v.innerHTML='<strong>Deferred interest is the trap in this category.</strong> If the balance is not cleared within '+promo+
        ' months, roughly '+usd(accrued)+' of accrued interest typically becomes payable in one go, on top of everything after. '+
        'Deferred does not mean waived. Ask in writing whether it is deferred interest or a genuine 0% instalment plan \u2014 they are '+
        'completely different products sold with the same words.';
    } else if(interest/P>0.5){
      v.className='verdict bad';
      v.innerHTML='<strong>You would repay '+usd(tot)+' on a '+usd(P)+' shower.</strong> The interest alone is '+usd(interest)+
        ' \u2014 more than the entire cost of buying a good panel kit and paying a local installer in cash. If the monthly payment is what makes '+
        'this affordable, the more useful move is to reduce the price rather than stretch the term.';
    } else if(interest/P>0.2){
      v.className='verdict warn';
      v.innerHTML='<strong>Interest adds '+usd(interest)+' to this project.</strong> Worth comparing against a home equity line or a credit union '+
        'personal loan, which frequently price well below contractor-arranged financing. Also worth asking what the cash price is \u2014 it is sometimes lower.';
    } else {
      v.className='verdict good';
      v.innerHTML='<strong>Total cost of credit is '+usd(interest)+'.</strong> That is a reasonable cost of borrowing. Still ask whether a cash '+
        'price exists, because financing is sometimes priced into the quote whether you use it or not.';
    }
  }
  ['f-amt','f-apr','f-term','f-promo'].forEach(function(i){
    var e=document.getElementById(i);if(e){e.addEventListener('input',run);e.addEventListener('change',run);}});
  run();
})();
</script>
